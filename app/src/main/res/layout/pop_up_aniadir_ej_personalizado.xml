<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_white"
    android:padding="24dp"
    android:layout_gravity="center">

    <TextView
        android:id="@+id/tvTituloPopUpEjercicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Añadir ejercicio"
        android:textColor="@color/gris_oscuro_texto"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="18dp" />

    <!-- Área de Imagen Centrada -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/ivSeleccionarImagen"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/cargar_imagen_default"
            android:scaleType="centerCrop"
            android:background="@drawable/edittext_border"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Seleccionar imagen" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="5dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/ic_add"
            android:background="@drawable/bg_circle_white"
            android:padding="4dp" />
    </FrameLayout>

    <!-- Sección Nombre -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textColor="@color/gris_oscuro_texto"
            android:textStyle="bold"
            android:layout_marginEnd="16dp" />

        <EditText
            android:id="@+id/etNombreEjercicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ingrese el nombre"
            android:textColorHint="@color/gris_pista"
            android:background="@drawable/edittext_bg_gray"
            android:textColor="@color/gris_oscuro_texto"
            android:textSize="14sp"
            android:inputType="textPersonName" />
    </LinearLayout>

    <!-- Nueva Sección: Tipo de Ejercicio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo"
            android:textColor="@color/gris_oscuro_texto"
            android:textStyle="bold"
            android:layout_marginEnd="16dp" />

        <RadioGroup
            android:id="@+id/rgTipoEjercicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rbFuerza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fuerza"
                android:textSize="13sp"
                android:checked="true"
                android:textColor="@color/gris_oscuro_texto"
                android:buttonTint="@color/selector_radio_checkbox"
                app:buttonTint="@color/selector_radio_checkbox" />
            <RadioButton
                android:id="@+id/rbCardio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cardio"
                android:textSize="13sp"
                android:textColor="@color/gris_oscuro_texto"
                android:buttonTint="@color/selector_radio_checkbox"
                app:buttonTint="@color/selector_radio_checkbox" />
        </RadioGroup>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="250dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Opciones Fuerza -->
            <LinearLayout
                android:id="@+id/llOpcionesFuerza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/cbPesoCorporal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¿Es peso corporal?"
                    android:textColor="@color/gris_oscuro_texto"
                    android:textSize="14sp"
                    android:buttonTint="@color/selector_radio_checkbox"
                    app:buttonTint="@color/selector_radio_checkbox" />

                <CheckBox
                    android:id="@+id/cbPesoPorLado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Peso por lado"
                    android:textColor="@color/gris_oscuro_texto"
                    android:textSize="14sp"
                    android:buttonTint="@color/selector_radio_checkbox"
                    app:buttonTint="@color/selector_radio_checkbox" />

                <LinearLayout
                    android:id="@+id/llContenedorBarra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tipo_de_barra"
                        android:textColor="@color/gris_oscuro_texto"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                    <Spinner
                        android:id="@+id/spTipoDeBarra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_bg_gray" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/peso_de_barra_kg"
                        android:textColor="@color/gris_oscuro_texto"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />
                    <EditText
                        android:id="@+id/etPesoBarra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_peso_barra"
                        android:background="@drawable/edittext_bg_gray"
                        android:textColor="@color/gris_oscuro_texto"
                        android:textSize="14sp"
                        android:inputType="numberDecimal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Opciones Cardio -->
            <LinearLayout
                android:id="@+id/llOpcionesCardio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Métricas a registrar:"
                    android:textColor="@color/gris_oscuro_texto"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <CheckBox
                    android:id="@+id/cbRegDistancia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Distancia"
                    android:textColor="@color/gris_oscuro_texto"
                    android:checked="true"
                    android:buttonTint="@color/selector_radio_checkbox"
                    app:buttonTint="@color/selector_radio_checkbox" />
                <CheckBox
                    android:id="@+id/cbRegCalorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Calorías"
                    android:textColor="@color/gris_oscuro_texto"
                    android:checked="true"
                    android:buttonTint="@color/selector_radio_checkbox"
                    app:buttonTint="@color/selector_radio_checkbox" />
                <CheckBox
                    android:id="@+id/cbRegCadencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cadencia"
                    android:textColor="@color/gris_oscuro_texto"
                    android:buttonTint="@color/selector_radio_checkbox"
                    app:buttonTint="@color/selector_radio_checkbox" />
                <CheckBox
                    android:id="@+id/cbRegRitmo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ritmo Cardíaco"
                    android:textColor="@color/gris_oscuro_texto"
                    android:buttonTint="@color/selector_radio_checkbox"
                    app:buttonTint="@color/selector_radio_checkbox" />
                <CheckBox
                    android:id="@+id/cbRegInclinacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inclinación"
                    android:textColor="@color/gris_oscuro_texto"
                    android:buttonTint="@color/selector_radio_checkbox"
                    app:buttonTint="@color/selector_radio_checkbox" />
                <CheckBox
                    android:id="@+id/cbRegResistencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resistencia"
                    android:textColor="@color/gris_oscuro_texto"
                    android:buttonTint="@color/selector_radio_checkbox"
                    app:buttonTint="@color/selector_radio_checkbox" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Botonera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnCancelarEjercicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:backgroundTint="#C14848"
            android:textColor="@color/white"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnAceptarEjercicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aceptar"
            android:textAllCaps="false"
            android:backgroundTint="#545B61"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
