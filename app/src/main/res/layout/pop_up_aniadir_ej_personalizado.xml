<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_white"
    android:padding="24dp"
    android:layout_gravity="center">

    <TextView
        android:id="@+id/tvTituloPopUpEjercicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Añadir ejercicio"
        android:textColor="@color/gris_oscuro_texto"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="18dp" />

    <!-- Área de Imagen Centrada y Grande -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/ivSeleccionarImagen"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/cargar_imagen_default"
            android:scaleType="centerCrop"
            android:background="@drawable/edittext_border"

            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Seleccionar imagen" />

        <!-- Pequeño indicador de cámara (Equilibrado) -->
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="10dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/ic_add"
            android:background="@drawable/bg_circle_white"
            android:padding="5dp"
            android:alpha="1.0" />
    </FrameLayout>

    <!-- Sección Nombre Igualada a Pop-up Modificar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textColor="@color/gris_oscuro_texto"
            android:textStyle="bold"
            android:layout_marginEnd="16dp" />

        <EditText
            android:id="@+id/etNombreEjercicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Ingrese el nombre"
            android:textColorHint="@color/gris_pista"
            android:background="@drawable/edittext_bg_gray"
            android:textColor="@color/gris_oscuro_texto"
            android:textCursorDrawable="@null"
            android:textSize="14sp"
            android:inputType="textPersonName" />
    </LinearLayout>

    <!-- Nueva Sección: Peso Corporal -->
    <CheckBox
        android:id="@+id/cbPesoCorporal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Es peso corporal?"
        android:textColor="@color/gris_oscuro_texto"
        android:layout_marginBottom="8dp"
        android:textSize="14sp"
        android:buttonTint="@color/gris_oscuro_texto" />

    <CheckBox
        android:id="@+id/cbPesoPorLado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Peso por lado"
        android:textColor="@color/gris_oscuro_texto"
        android:layout_marginBottom="16dp"
        android:textSize="14sp"
        android:buttonTint="@color/gris_oscuro_texto" />

    <!-- Contenedor de Opciones de Barra (Visible solo si PesoPorLado está marcado) -->
    <LinearLayout
        android:id="@+id/llContenedorBarra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tipo_de_barra"
                android:textColor="@color/gris_oscuro_texto"
                android:textStyle="bold"
                android:layout_marginEnd="16dp" />

            <Spinner
                android:id="@+id/spTipoDeBarra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/edittext_bg_gray" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/peso_de_barra_kg"
                android:textColor="@color/gris_oscuro_texto"
                android:textStyle="bold"
                android:layout_marginEnd="16dp" />

            <EditText
                android:id="@+id/etPesoBarra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_peso_barra"
                android:textColorHint="@color/gris_pista"
                android:background="@drawable/edittext_bg_gray"
                android:textColor="@color/gris_oscuro_texto"
                android:textCursorDrawable="@null"
                android:textSize="14sp"
                android:inputType="numberDecimal" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botonera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnCancelarEjercicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:backgroundTint="#C14848"
            android:textColor="@color/white"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnAceptarEjercicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Aceptar"
            android:textAllCaps="false"
            android:backgroundTint="#545B61"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>