<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    tools:context=".CargarRegistroFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clMainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvEjercicioImagen"
                android:layout_width="140dp"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:visibility="gone"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#40FFFFFF"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivEjercicioImagen"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Imagen del ejercicio" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvNombreEjercicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nombre del Ejercicio"
                android:textColor="@color/blanco"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cvEjercicioImagen"
                app:layout_goneMarginTop="16dp" />

            <TextView
                android:id="@+id/tvInfoBarra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barra: Ninguna (0 kg)"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvNombreEjercicio" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvMejorPuntaje"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:strokeColor="#40FFFFFF"
                app:strokeWidth="0.5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvInfoBarra">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvTituloMejorPuntaje"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=" MEJOR PUNTAJE"
                            android:textColor="@color/blanco"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleGroupMejorPuntaje"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTogglePeso"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="0dp"
                                android:text="Peso"
                                android:textSize="11sp"
                                android:textColor="@color/blanco"
                                app:strokeColor="#40FFFFFF" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTogglePesoXReps"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="0dp"
                                android:text="Peso × Reps"
                                android:textSize="11sp"
                                android:textColor="@color/blanco"
                                app:strokeColor="#40FFFFFF" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvValorMejorPuntaje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="--"
                        android:textColor="@color/blanco"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetalleMejorPuntaje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Sin registros previos"
                        android:textColor="#BBBBBB"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llInputs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                app:layout_constraintTop_toBottomOf="@id/cvMejorPuntaje">

                <TextView
                    android:id="@+id/labelSerie"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Serie"
                    android:textColor="@color/blanco"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/labelReps"
                    app:layout_constraintHorizontal_weight="0.8"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/labelReps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Repeticiones"
                    android:textColor="@color/blanco"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/tvUnidadPeso"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/labelSerie"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvUnidadPeso"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="kg"
                    android:textColor="@color/blanco"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1.2"
                    app:layout_constraintStart_toEndOf="@+id/labelReps"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSerieValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/blanco"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/npRepeticiones"
                    app:layout_constraintEnd_toEndOf="@+id/labelSerie"
                    app:layout_constraintStart_toStartOf="@+id/labelSerie"
                    app:layout_constraintTop_toTopOf="@+id/npRepeticiones" />

                <NumberPicker
                    android:id="@+id/npRepeticiones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:theme="@style/PickerStyle"
                    app:layout_constraintEnd_toEndOf="@+id/labelReps"
                    app:layout_constraintStart_toStartOf="@+id/labelReps"
                    app:layout_constraintTop_toBottomOf="@+id/labelReps" />

                <LinearLayout
                    android:id="@+id/containerPeso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintBottom_toBottomOf="@+id/npRepeticiones"
                    app:layout_constraintEnd_toEndOf="@+id/tvUnidadPeso"
                    app:layout_constraintStart_toStartOf="@+id/tvUnidadPeso"
                    app:layout_constraintTop_toTopOf="@+id/npRepeticiones">

                    <NumberPicker
                        android:id="@+id/npPesoEntero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:theme="@style/PickerStyle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text=","
                        android:textColor="@color/blanco"
                        android:textSize="24sp" />

                    <NumberPicker
                        android:id="@+id/npPesoDecimal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:theme="@style/PickerStyle" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/btnCargar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#403C3C"
                android:text="Registrar +"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                app:cornerRadius="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llInputs" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clTimerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                app:layout_constraintTop_toBottomOf="@id/btnCargar">


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:cardBackgroundColor="#1A1A1A"
                    app:cardElevation="8dp"
                    app:cardMaxElevation="10dp"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="#40FFFFFF"
                    app:strokeWidth="0.5dp"
                    app:cardCornerRadius="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <TextView
                        android:id="@+id/tvTimerValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="4dp"
                        android:text="01:00"
                        android:textColor="@color/blanco"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:id="@+id/ivEditTimer"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_edit_outline"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintBottom_toBottomOf="@+id/cvTimer"
                    app:layout_constraintStart_toEndOf="@+id/cvTimer"
                    app:layout_constraintTop_toTopOf="@+id/cvTimer"
                    app:tint="@color/blanco" />

                <ImageButton
                    android:id="@+id/btnStartTimer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_play"
                    app:layout_constraintBottom_toBottomOf="@+id/cvTimer"
                    app:layout_constraintEnd_toStartOf="@+id/cvTimer"
                    app:layout_constraintTop_toTopOf="@+id/cvTimer"
                    app:tint="@color/blanco" />

                <ImageButton
                    android:id="@+id/btnResetTimer"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="9dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_reset"
                    app:layout_constraintBottom_toBottomOf="@+id/cvTimer"
                    app:layout_constraintStart_toEndOf="@+id/ivEditTimer"
                    app:layout_constraintTop_toTopOf="@+id/cvTimer"
                    app:tint="@color/blanco" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/btnVerHistorialPrevio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#403C3C"
                android:text="REGISTROS RECIENTES"
                android:textAllCaps="true"
                android:textColor="@color/blanco"
                app:cornerRadius="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/clTimerContainer" />

            <FrameLayout
                android:id="@+id/flHistorialHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#1A1A1A"
                app:layout_constraintTop_toBottomOf="@id/btnVerHistorialPrevio">

                <TextView
                    android:id="@+id/tvHistorialHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="Historial"
                    android:textColor="@color/blanco"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnEliminarUltimo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/blanco" />
            </FrameLayout>

            <TableLayout
                android:id="@+id/tlHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                app:layout_constraintTop_toBottomOf="@id/flHistorialHeader">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#0F0F0F">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Series"
                        android:textColor="@color/blanco"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Repeticiones"
                        android:textColor="@color/blanco"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvColumnaPeso"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="Peso"
                        android:textColor="@color/blanco"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvColumnaEditar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.25"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text=""
                        android:textColor="@color/blanco"
                        android:textStyle="bold" />
                </TableRow>
            </TableLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="24dp"
                android:clipToPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tlHistorial" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/flExpandedImageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD000000"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivEjercicioImagenExpanded"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:scaleType="fitCenter"
            android:contentDescription="Imagen del ejercicio ampliada" />
    </FrameLayout>

</FrameLayout>
