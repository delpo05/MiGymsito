<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_white"
    android:padding="20dp"
    android:layout_gravity="center">

    <!-- Título del ejercicio -->
    <TextView
        android:id="@+id/tvTituloDetalleEjercicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Nombre del Ejercicio"
        android:textColor="@color/gris_oscuro_texto"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Imagen / GIF Explicativo -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="14dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#EEEEEE"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/ivDetalleEjercicio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/cargar_imagen_default"
            android:contentDescription="Imagen o GIF explicativo del ejercicio" />
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="220dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sección Instrucciones y Notas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instrucciones / Notas:"
                android:textColor="@color/gris_oscuro_texto"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvDetalleDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin descripción registrada."
                android:textColor="#555555"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:background="@drawable/edittext_bg_gray"
                android:padding="10dp"
                android:layout_marginBottom="12dp" />

            <!-- Ficha Técnica -->
            <TextView
                android:id="@+id/tvDetalleEspecificaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Categoría: Fuerza"
                android:textColor="#777777"
                android:textSize="12sp"
                android:textStyle="italic" />

        </LinearLayout>
    </ScrollView>

    <!-- Botonera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnCerrarDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cerrar"
            android:textAllCaps="false"
            android:backgroundTint="#545B61"
            android:textColor="@color/white"
            app:cornerRadius="20dp" />

    </LinearLayout>

</LinearLayout>
